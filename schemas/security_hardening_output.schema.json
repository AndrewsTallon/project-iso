{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iso.local/schemas/security_hardening_output.schema.json",
  "title": "Security Hardening Output",
  "allOf": [
    {
      "$ref": "agent_envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "assigned_agent",
        "hardening_plan"
      ],
      "properties": {
        "assigned_agent": {
          "const": "security_hardening"
        },
        "hardening_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_items",
            "isolation_controls",
            "key_management_controls"
          ],
          "properties": {
            "baseline_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "isolation_controls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "key_management_controls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "coverage_claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "bsi_domains": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
