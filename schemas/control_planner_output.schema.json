{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iso.local/schemas/control_planner_output.schema.json",
  "title": "Control Planner Output",
  "allOf": [
    {
      "$ref": "agent_envelope.schema.json"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["assigned_agent", "plan"],
      "properties": {
        "assigned_agent": {"const": "control_planner"},
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control_decisions", "architecture_constraints", "bsi_mapping_notes"],
          "properties": {
            "control_decisions": {"type": "array", "items": {"type": "string"}},
            "architecture_constraints": {"type": "array", "items": {"type": "string"}},
            "bsi_mapping_notes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  ]
}
