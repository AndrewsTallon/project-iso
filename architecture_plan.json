        "controls": ["A.8.17", "A.5.28", "A.8.15"],
        "dependency_reason": "Reliable timestamps are required for non-repudiable log and evidence chain validation."
      },
      {
        "controls": ["A.8.9", "A.8.32", "A.8.34"],
        "dependency_reason": "Change records must map to baseline drift and protected audit-testing windows."
      },
      {
        "controls": ["A.8.7", "A.8.8", "A.8.13", "A.5.30"],
        "dependency_reason": "Recovery readiness is impacted by malware and vulnerability status of systems being restored."
      },
      {
        "controls": ["A.8.20", "A.8.21", "A.8.22", "A.8.24"],
        "dependency_reason": "Network service security and segmentation depend on transport protection and crypto posture."
      },
      {
        "controls": ["A.5.31", "A.5.34", "A.8.10", "A.8.11", "A.8.12"],
        "dependency_reason": "Legal/privacy obligations drive required implementation evidence for deletion, masking, and leakage prevention."
      },
      {
        "controls": ["A.5.19", "A.5.20", "A.5.21", "A.8.30"],
        "dependency_reason": "Supplier and outsourced development controls share contract and assurance evidence sources."
      }
    ]
  },
  "implementation_phases": [
    {
      "phase": "MVP",
      "focus_modules": ["mod_asset_inventory", "mod_evidence_integrity_export", "mod_identity_access_posture", "mod_configuration_change_baseline", "mod_vulnerability_malware_patch", "mod_logging_monitoring_time", "mod_backup_recovery_resilience", "mod_network_crypto_posture"],
      "rationale": "Implements all P1 controls first with shared collectors and central evidence integrity, sized for Intel N100 by using scheduled pull-based collection and lightweight local storage/indexing."
    },
    {
      "phase": "v2",
      "focus_modules": ["mod_data_protection_lifecycle", "mod_secure_development_assurance"],
      "rationale": "Adds P2 technical controls using existing inventory, evidence, and change pipelines; extends into SDLC and data lifecycle controls without cloud connectors."
    },
    {
      "phase": "v3",
      "focus_modules": ["mod_governance_supplier_compliance"],
      "rationale": "Completes broad P3 governance, personnel, supplier, and physical control evidence orchestration using reusable registry and workflow foundations."
    }
  ],
