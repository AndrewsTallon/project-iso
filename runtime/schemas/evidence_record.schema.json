{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iso.local/runtime/schemas/evidence_record.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "collector_id",
    "host_id",
    "timestamp_utc",
    "command_ref",
    "artifact_path",
    "artifact_hash",
    "control_refs",
    "retention_class"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "collector_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "command_ref": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "control_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "retention_class": {
      "type": "string",
      "enum": ["short", "standard", "extended"]
    }
  }
}
