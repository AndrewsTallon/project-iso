#!/usr/bin/env bash
set -euo pipefail

VERSION="${1:-0.1.0}"
STAGING="dist/staging/runtime-${VERSION}"
rm -rf "$STAGING"
mkdir -p "$STAGING"

cp -R runtime "$STAGING/"
cp README.md "$STAGING/"

MANIFEST="dist/manifest-${VERSION}.txt"
CHECKSUMS="dist/checksums-${VERSION}.sha256"
META="dist/version-${VERSION}.json"

find "$STAGING" -type f | LC_ALL=C sort > "$MANIFEST"

TAR_PATH="dist/runtime-${VERSION}.tar.gz"
ZIP_PATH="dist/runtime-${VERSION}.zip"

rm -f "$TAR_PATH" "$ZIP_PATH" "$CHECKSUMS" "$META"

tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner -czf "$TAR_PATH" -C "dist/staging" "runtime-${VERSION}"
(
  cd "dist/staging"
  find "runtime-${VERSION}" -type f | LC_ALL=C sort | zip -X -q -@ "../runtime-${VERSION}.zip"
)

sha256sum "$TAR_PATH" "$ZIP_PATH" "$MANIFEST" > "$CHECKSUMS"
cat > "$META" <<JSON
{
  "version": "$VERSION",
  "artifacts": [
    "runtime-${VERSION}.tar.gz",
    "runtime-${VERSION}.zip",
    "manifest-${VERSION}.txt",
    "checksums-${VERSION}.sha256"
  ]
}
JSON

echo "packaged dist artifacts for $VERSION"
